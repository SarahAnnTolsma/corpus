# Open Paleo paper-archive — credentials template.
# Copy to .env (mode 0600) and fill in. Never commit .env.

# Unpaywall API requires a contact email per their ToS.
UNPAYWALL_EMAIL=

# Biodiversity Heritage Library API key (free, register at
# https://www.biodiversitylibrary.org/getapikey.aspx).
BHL_API_KEY=

# Anthropic API key for vision OCR + translation passes
# (console.anthropic.com → API Keys; pay-as-you-go billing).
ANTHROPIC_API_KEY=

# Where references.bib comes from (default auto: ../data if present, else
# bib/references.bib if present, else downloaded from the data repo on GitHub).
#   sibling  OPEN_PALEO_DATA/dist/references.bib (OPEN_PALEO_DATA default ../data)
#   bundled  bib/references.bib in this repository
#   remote   CORPUS_BIB_URL, cached in .runtime/cache/bib/
# CORPUS_BIB_SOURCE=auto
# OPEN_PALEO_DATA=../data
